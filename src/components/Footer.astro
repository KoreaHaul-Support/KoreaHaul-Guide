---
// Replaces the "Ready to start?" block that was repeated at the bottom of every Notion page.
import Default from '@astrojs/starlight/components/Footer.astro';
import { useT } from '../i18n/ui';

const { id: rawId = '', locale } = Astro.locals.starlightRoute;
const t = useT(locale);
const id = locale ? rawId.replace(new RegExp(`^${locale}(/|$)`), '') : rawId;
const isHome = id === '' || id === 'index';
---

{
  !isHome && (
    <section class="kh-cta" aria-labelledby="kh-cta-title">
      <h2 id="kh-cta-title">{t('ctaTitle')}</h2>
      <p>
        <a class="kh-button" href="https://koreahaul.com/">{t('ctaButton')}</a>
        <span>{t('ctaText')}</span>
      </p>
      <p class="kh-small">
        <em>{t('ctaDisclaimer')}</em>
      </p>
      <p class="kh-report">
        <strong>{t('reportTitle')}</strong> {t('reportText')}
      </p>
      <p class="kh-small">
        <strong>{t('policiesTitle')}</strong><br />
        <span class="kh-links">
          <a href="https://koreahaul.com/terms-of-service">{t('tos')}</a>
          <a href="https://koreahaul.com/privacy-policy">{t('privacy')}</a>
          <a href="https://koreahaul.com/support/shipping-policy">{t('shippingPolicy')}</a>
          <a href="https://koreahaul.com/support/refund-policy">{t('refundPolicy')}</a>
        </span>
      </p>
      <p class="kh-small">
        {t('followA')} <a href="https://www.instagram.com/koreahaulofficial/">Instagram</a> {t('followAnd')}{' '}
        <a href="https://www.tiktok.com/@koreahaulofficial">TikTok</a>{t('followB') && ' '}{t('followB')}
      </p>
    </section>
  )
}
<Default />
