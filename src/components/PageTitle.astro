---
// Page title with a simple breadcrumb (Home / Section) above it.
import Default from '@astrojs/starlight/components/PageTitle.astro';

const id = Astro.locals.starlightRoute.id || '';
const SECTIONS: Record<string, [string, string]> = {
  news: ['News & Updates', '/topics/news/'],
  'getting-started': ['Getting Started & Services', '/topics/getting-started/'],
  shipping: ['International Shipping Tips', '/topics/shipping/'],
  'country-guide': ['Country Guide', '/country-guide/'],
  'shopping-tips': ['Shopping Tips', '/topics/shopping-tips/'],
  'what-to-buy': ['What to Buy', '/topics/what-to-buy/'],
};

const parts = id.split('/');
const crumbs: [string, string][] = [['Home', '/']];
const section = SECTIONS[parts[0]];
// The Country Guide overview is itself the section page, so it only gets "Home".
if (section && id !== 'country-guide') crumbs.push(section);
if (parts[0] === 'shopping-tips' && parts[1] === 'stores') {
  crumbs.push(['Popular stores', '/shopping-tips/shop-from-popular-stores/']);
}
const show = id !== '' && id !== 'index';
---

{
  show && (
    <nav class="kh-crumbs" aria-label="Breadcrumb">
      {crumbs.map(([label, href], i) => (
        <>
          {i > 0 && <span class="kh-crumb-sep" aria-hidden="true">/</span>}
          <a href={href}>{label}</a>
        </>
      ))}
    </nav>
  )
}
<Default />
