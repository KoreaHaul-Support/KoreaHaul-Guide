---
// Help-center style hero for the home page: big title, tagline, search box, two buttons.

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="kh-hero">
  <h1 id="_top" data-page-title set:html={title} />
  {tagline && <p class="kh-hero-tagline" set:html={tagline} />}
  <button class="kh-hero-search" type="button" data-kh-search aria-label="Search the guide">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
    <span class="kh-hero-search-text">Search fees, shipping, stores...</span>
  </button>
  {
    actions.length > 0 && (
      <div class="kh-hero-actions">
        {actions.map(({ link, text, variant }) => (
          <a href={link} class:list={['kh-btn', variant === 'primary' ? 'kh-btn-dark' : 'kh-btn-line']}>
            {text}
          </a>
        ))}
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll('[data-kh-search]').forEach((el) =>
    el.addEventListener('click', () => {
      document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
    })
  );
</script>
